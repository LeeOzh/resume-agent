/* ============================================================
   ResumeAgent 亮色主题（Modern Light）
   设计令牌：主色 #2563EB / 成功 #16A34A / 危险 #DC2626 / 警告 #D97706
   文字：#0F172A / #475569 / #94A3B8   边框：#E2E8F0
   ============================================================ */

/* ---------- 全局 ---------- */
QWidget {
    color: #0F172A;
    font-family: "Microsoft YaHei UI", "Microsoft YaHei", sans-serif;
    font-size: 13px;
}

QMainWindow {
    background-color: #F3F3F3;
}

/* 无边框窗口容器：铺满窗口，无外层边距/阴影/圆角 */
QFrame#windowContainer {
    background-color: #F3F3F3;
    border: none;
}

/* ---------- 标题栏 ---------- */
QWidget#titleBar {
    background-color: #FFFFFF;
    border-bottom: 1px solid #EEF2F7;
}

QLabel#titleLabel {
    color: #0F172A;
    font-size: 14px;
    font-weight: 600;
}

QToolButton#minBtn, QToolButton#maxBtn, QToolButton#closeBtn {
    border: none;
    border-radius: 8px;
    background-color: transparent;
    color: #475569;
}

QToolButton#minBtn:hover, QToolButton#maxBtn:hover {
    background-color: #F1F5F9;
    color: #0F172A;
}

QToolButton#closeBtn:hover {
    background-color: #DC2626;
    color: #FFFFFF;
}

/* ---------- 菜单 ---------- */
QMenuBar {
    background-color: #FFFFFF;
    border-bottom: 1px solid #EEF2F7;
    padding: 4px 8px;
    color: #0F172A;
}

QMenuBar::item {
    padding: 6px 12px;
    border-radius: 6px;
    background: transparent;
    color: #0F172A;
}

QMenuBar::item:selected {
    background-color: #EFF6FF;
    color: #1D4ED8;
}

QMenu {
    background-color: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 10px;
    padding: 6px;
    color: #0F172A;
}

QMenu::item {
    padding: 7px 24px 7px 12px;
    border-radius: 6px;
    color: #0F172A;
}

QMenu::item:selected {
    background-color: #EFF6FF;
    color: #1D4ED8;
}

QMenu::item:disabled {
    color: #94A3B8;
}

/* ---------- 工具栏 ---------- */
QToolBar {
    background-color: #FFFFFF;
    border-bottom: 1px solid #EEF2F7;
    padding: 6px 12px;
    spacing: 8px;
}

QToolBar QPushButton {
    padding: 6px 14px;
    border: 1px solid #E2E8F0;
    border-radius: 8px;
    background-color: #FFFFFF;
    color: #334155;
    font-weight: 500;
}

QToolBar QPushButton:hover {
    background-color: #F8FAFC;
    border-color: #CBD5E1;
    color: #0F172A;
}

QToolBar QPushButton:pressed {
    background-color: #F1F5F9;
}

/* ---------- 表格 ---------- */
QTableWidget {
    background-color: #FFFFFF;
    alternate-background-color: #F8FAFC;
    border: 1px solid #E2E8F0;
    border-radius: 10px;
    gridline-color: #F1F5F9;
    color: #0F172A;
    selection-background-color: #EFF6FF;
    selection-color: #0F172A;
    outline: none;
}

QTableWidget::item {
    padding: 6px 8px;
    border-bottom: 1px solid #F1F5F9;
    color: #0F172A;
}

QTableWidget::item:selected {
    background-color: #EFF6FF;
    color: #0F172A;
}

QTableWidget::item:hover {
    background-color: #F1F5F9;
}

QHeaderView::section {
    background-color: #F8FAFC;
    border: none;
    border-bottom: 1px solid #E2E8F0;
    border-right: 1px solid #F1F5F9;
    padding: 9px 8px;
    font-weight: 600;
    color: #475569;
}

QHeaderView::section:hover {
    background-color: #F1F5F9;
}

QTableCornerButton::section {
    background-color: #F8FAFC;
    border: none;
    border-bottom: 1px solid #E2E8F0;
}

/* ---------- 文本编辑 ---------- */
QTextEdit {
    background-color: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 10px;
    padding: 8px;
    font-family: "Consolas", "Microsoft YaHei UI", monospace;
    font-size: 12px;
    color: #0F172A;
    selection-background-color: #BFDBFE;
}

QTextBrowser {
    background-color: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 10px;
    padding: 8px;
    color: #0F172A;
}

/* ---------- 分组卡片 ---------- */
QGroupBox {
    background-color: #FFFFFF;
    border: 1px solid #E5E5E5;
    border-radius: 8px;
    margin-top: 14px;
    padding: 14px 12px 12px 12px;
    font-weight: 600;
    color: #0F172A;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 8px;
    color: #334155;
    background-color: transparent;
}

/* ---------- 按钮 ---------- */
QPushButton {
    padding: 8px 18px;
    border: 1px solid #E2E8F0;
    border-radius: 8px;
    background-color: #FFFFFF;
    min-width: 80px;
    color: #334155;
    font-weight: 500;
}

QPushButton:hover {
    background-color: #F8FAFC;
    border-color: #CBD5E1;
    color: #0F172A;
}

QPushButton:pressed {
    background-color: #F1F5F9;
}

QPushButton:disabled {
    background-color: #F8FAFC;
    color: #CBD5E1;
    border-color: #EEF2F7;
}

QPushButton:focus {
    border: 2px solid #93C5FD;
}

/* 主按钮（开始下载） */
QPushButton#start_btn {
    background-color: #2563EB;
    color: #FFFFFF;
    border: none;
    font-weight: 600;
}

QPushButton#start_btn:hover {
    background-color: #1D4ED8;
    color: #FFFFFF;
}

QPushButton#start_btn:pressed {
    background-color: #1E40AF;
    color: #FFFFFF;
}

QPushButton#start_btn:disabled {
    background-color: #BFDBFE;
    color: #FFFFFF;
}

/* 危险按钮（中断下载） */
QPushButton#stop_btn {
    background-color: #DC2626;
    color: #FFFFFF;
    border: none;
    font-weight: 600;
}

QPushButton#stop_btn:hover {
    background-color: #B91C1C;
    color: #FFFFFF;
}

QPushButton#stop_btn:pressed {
    background-color: #991B1B;
    color: #FFFFFF;
}

/* 警告按钮（暂停） */
QPushButton#pause_btn {
    background-color: #D97706;
    color: #FFFFFF;
    border: none;
    font-weight: 600;
}

QPushButton#pause_btn:hover {
    background-color: #B45309;
    color: #FFFFFF;
}

/* 次要强调按钮（继续任务） */
QPushButton#resume_btn {
    background-color: #FFFFFF;
    color: #2563EB;
    border: 1px solid #93C5FD;
    font-weight: 600;
}

QPushButton#resume_btn:hover {
    background-color: #EFF6FF;
    color: #1D4ED8;
}

/* ---------- 输入控件 ---------- */
QLineEdit {
    padding: 7px 10px;
    border: 1px solid #E2E8F0;
    border-radius: 8px;
    background-color: #FFFFFF;
    color: #0F172A;
    selection-background-color: #BFDBFE;
}

QLineEdit:hover {
    border-color: #CBD5E1;
}

QLineEdit:focus {
    border: 2px solid #2563EB;
    padding: 6px 9px;
}

QLineEdit:disabled {
    background-color: #F8FAFC;
    color: #94A3B8;
}

/* 表格内嵌输入框：减小上下 padding，避免被行高压扁导致文字不可见 */
QTableWidget QLineEdit {
    padding: 3px 8px;
}

QComboBox {
    padding: 7px 10px;
    border: 1px solid #E2E8F0;
    border-radius: 8px;
    background-color: #FFFFFF;
    color: #0F172A;
}

QComboBox:hover {
    border-color: #CBD5E1;
}

QComboBox:focus {
    border: 2px solid #2563EB;
}

QComboBox::drop-down {
    border: none;
    width: 26px;
}

QComboBox::down-arrow {
    image: none;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid #64748B;
    margin-right: 8px;
}

QComboBox QAbstractItemView {
    background-color: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 8px;
    padding: 4px;
    color: #0F172A;
    selection-background-color: #EFF6FF;
    selection-color: #1D4ED8;
    outline: none;
}

QSpinBox {
    padding: 6px 10px;
    border: 1px solid #E2E8F0;
    border-radius: 8px;
    background-color: #FFFFFF;
    color: #0F172A;
}

/* ---------- 进度条 ---------- */
QProgressBar {
    border: none;
    border-radius: 6px;
    text-align: center;
    background-color: #F1F5F9;
    color: #475569;
    font-size: 12px;
    min-height: 12px;
}

QProgressBar::chunk {
    background-color: #2563EB;
    border-radius: 6px;
}

/* ---------- 状态栏 ---------- */
QStatusBar {
    background-color: #FFFFFF;
    border-top: 1px solid #EEF2F7;
    padding: 4px 8px;
    color: #475569;
}

QStatusBar::item {
    border: none;
}

QStatusBar QLabel {
    color: #475569;
    padding: 0 10px;
    font-size: 12px;
}

/* ---------- 标签 / 复选框 ---------- */
QLabel {
    color: #0F172A;
}

QCheckBox {
    spacing: 8px;
    color: #0F172A;
}

QCheckBox::indicator {
    width: 17px;
    height: 17px;
    border: 1.5px solid #CBD5E1;
    border-radius: 5px;
    background-color: #FFFFFF;
}

QCheckBox::indicator:hover {
    border-color: #2563EB;
    background-color: #EFF6FF;
}

QCheckBox::indicator:checked {
    background-color: #2563EB;
    border-color: #2563EB;
}

QRadioButton {
    spacing: 8px;
    color: #0F172A;
}

QRadioButton::indicator {
    width: 17px;
    height: 17px;
    border: 1.5px solid #CBD5E1;
    border-radius: 9px;
    background-color: #FFFFFF;
}

QRadioButton::indicator:checked {
    background-color: #2563EB;
    border-color: #2563EB;
}

/* ---------- 对话框 ---------- */
QDialog {
    background-color: #FFFFFF;
    color: #0F172A;
}

QMessageBox {
    background-color: #FFFFFF;
    color: #0F172A;
}

QMessageBox QLabel {
    color: #0F172A;
    font-size: 13px;
}

/* ---------- 选项卡 ---------- */
QTabWidget::pane {
    border: 1px solid #E2E8F0;
    border-radius: 10px;
    background-color: #FFFFFF;
    top: -1px;
}

QTabBar::tab {
    background-color: transparent;
    border: none;
    border-bottom: 2px solid transparent;
    padding: 9px 18px;
    color: #64748B;
    font-weight: 500;
}

QTabBar::tab:selected {
    border-bottom: 2px solid #2563EB;
    color: #2563EB;
}

QTabBar::tab:hover:!selected {
    color: #0F172A;
}

/* ---------- 滚动条 ---------- */
QScrollBar:vertical {
    background-color: transparent;
    width: 10px;
    margin: 2px;
    border: none;
}

QScrollBar::handle:vertical {
    background-color: #CBD5E1;
    border-radius: 5px;
    min-height: 32px;
}

QScrollBar::handle:vertical:hover {
    background-color: #94A3B8;
}

QScrollBar:horizontal {
    background-color: transparent;
    height: 10px;
    margin: 2px;
    border: none;
}

QScrollBar::handle:horizontal {
    background-color: #CBD5E1;
    border-radius: 5px;
    min-width: 32px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #94A3B8;
}

QScrollBar::add-line, QScrollBar::sub-line {
    width: 0px;
    height: 0px;
}

QScrollBar::add-page, QScrollBar::sub-page {
    background: transparent;
}

/* ---------- 分割器 ---------- */
QSplitter::handle {
    background-color: transparent;
}

QSplitter::handle:horizontal {
    width: 6px;
}

QSplitter::handle:vertical {
    height: 6px;
}

QSplitter::handle:hover {
    background-color: #E2E8F0;
}

/* 滚动区域：视口透明跟随容器背景（避免缝隙透出系统暗色） */
QScrollArea {
    background-color: transparent;
    border: none;
}

QScrollArea > QWidget > QWidget {
    background-color: transparent;
}

/* ---------- 工具提示 ---------- */
QToolTip {
    background-color: #0F172A;
    border: none;
    border-radius: 6px;
    color: #F8FAFC;
    padding: 6px 10px;
    font-size: 12px;
}
