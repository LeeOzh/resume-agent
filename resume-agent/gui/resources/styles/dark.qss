/* ============================================================
   ResumeAgent 暗色主题（Modern Dark）
   背景 #0F172A / 面板 #1E293B / 边框 #334155
   主色 #3B82F6 / 成功 #22C55E / 危险 #EF4444 / 警告 #F59E0B
   ============================================================ */

QWidget {
    color: #E2E8F0;
    font-family: "Microsoft YaHei UI", "Microsoft YaHei", sans-serif;
    font-size: 13px;
}

QMainWindow {
    background-color: #202020;
}

QFrame#windowContainer {
    background-color: #202020;
    border: none;
}

QWidget#titleBar {
    background-color: #0F172A;
    border-bottom: 1px solid #1E293B;
}

QLabel#titleLabel {
    color: #F1F5F9;
    font-size: 14px;
    font-weight: 600;
}

QToolButton#minBtn, QToolButton#maxBtn, QToolButton#closeBtn {
    border: none;
    border-radius: 8px;
    background-color: transparent;
    color: #94A3B8;
}

QToolButton#minBtn:hover, QToolButton#maxBtn:hover {
    background-color: #334155;
    color: #F1F5F9;
}

QToolButton#closeBtn:hover {
    background-color: #EF4444;
    color: #FFFFFF;
}

QMenuBar {
    background-color: #0F172A;
    border-bottom: 1px solid #1E293B;
    padding: 4px 8px;
    color: #E2E8F0;
}

QMenuBar::item {
    padding: 6px 12px;
    border-radius: 6px;
    background: transparent;
    color: #E2E8F0;
}

QMenuBar::item:selected {
    background-color: #1E293B;
    color: #93C5FD;
}

QMenu {
    background-color: #1E293B;
    border: 1px solid #334155;
    border-radius: 10px;
    padding: 6px;
    color: #E2E8F0;
}

QMenu::item {
    padding: 7px 24px 7px 12px;
    border-radius: 6px;
    color: #E2E8F0;
}

QMenu::item:selected {
    background-color: #334155;
    color: #93C5FD;
}

QMenu::item:disabled {
    color: #64748B;
}

QToolBar {
    background-color: #0F172A;
    border-bottom: 1px solid #1E293B;
    padding: 6px 12px;
    spacing: 8px;
}

QToolBar QPushButton {
    padding: 6px 14px;
    border: 1px solid #334155;
    border-radius: 8px;
    background-color: #1E293B;
    color: #CBD5E1;
    font-weight: 500;
}

QToolBar QPushButton:hover {
    background-color: #334155;
    border-color: #475569;
    color: #F1F5F9;
}

QToolBar QPushButton:pressed {
    background-color: #0F172A;
}

QTableWidget {
    background-color: #0F172A;
    alternate-background-color: #16213A;
    border: 1px solid #1E293B;
    border-radius: 10px;
    gridline-color: #1E293B;
    color: #E2E8F0;
    selection-background-color: #1E3A8A;
    selection-color: #F1F5F9;
    outline: none;
}

QTableWidget::item {
    padding: 6px 8px;
    border-bottom: 1px solid #1E293B;
    color: #E2E8F0;
}

QTableWidget::item:selected {
    background-color: #1E3A8A;
    color: #F1F5F9;
}

QTableWidget::item:hover {
    background-color: #1E293B;
}

QHeaderView::section {
    background-color: #1E293B;
    border: none;
    border-bottom: 1px solid #334155;
    border-right: 1px solid #1E293B;
    padding: 9px 8px;
    font-weight: 600;
    color: #94A3B8;
}

QHeaderView::section:hover {
    background-color: #334155;
}

QTableCornerButton::section {
    background-color: #1E293B;
    border: none;
    border-bottom: 1px solid #334155;
}

QTextEdit {
    background-color: #0F172A;
    border: 1px solid #334155;
    border-radius: 10px;
    padding: 8px;
    font-family: "Consolas", "Microsoft YaHei UI", monospace;
    font-size: 12px;
    color: #E2E8F0;
    selection-background-color: #1D4ED8;
}

QTextBrowser {
    background-color: #0F172A;
    border: 1px solid #334155;
    border-radius: 10px;
    padding: 8px;
    color: #E2E8F0;
}

QGroupBox {
    background-color: #2B2B2B;
    border: 1px solid #3C3C3C;
    border-radius: 8px;
    margin-top: 14px;
    padding: 14px 12px 12px 12px;
    font-weight: 600;
    color: #F1F5F9;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 8px;
    color: #94A3B8;
    background-color: transparent;
}

QPushButton {
    padding: 8px 18px;
    border: 1px solid #334155;
    border-radius: 8px;
    background-color: #1E293B;
    min-width: 80px;
    color: #CBD5E1;
    font-weight: 500;
}

QPushButton:hover {
    background-color: #334155;
    border-color: #475569;
    color: #F1F5F9;
}

QPushButton:pressed {
    background-color: #0F172A;
}

QPushButton:disabled {
    background-color: #16213A;
    color: #475569;
    border-color: #1E293B;
}

QPushButton:focus {
    border: 2px solid #3B82F6;
}

QPushButton#start_btn {
    background-color: #2563EB;
    color: #FFFFFF;
    border: none;
    font-weight: 600;
}

QPushButton#start_btn:hover {
    background-color: #3B82F6;
    color: #FFFFFF;
}

QPushButton#start_btn:pressed {
    background-color: #1D4ED8;
    color: #FFFFFF;
}

QPushButton#start_btn:disabled {
    background-color: #1E3A8A;
    color: #93C5FD;
}

QPushButton#stop_btn {
    background-color: #DC2626;
    color: #FFFFFF;
    border: none;
    font-weight: 600;
}

QPushButton#stop_btn:hover {
    background-color: #EF4444;
    color: #FFFFFF;
}

QPushButton#pause_btn {
    background-color: #D97706;
    color: #FFFFFF;
    border: none;
    font-weight: 600;
}

QPushButton#pause_btn:hover {
    background-color: #F59E0B;
    color: #0F172A;
}

QPushButton#resume_btn {
    background-color: #1E293B;
    color: #93C5FD;
    border: 1px solid #3B82F6;
    font-weight: 600;
}

QPushButton#resume_btn:hover {
    background-color: #1E3A8A;
    color: #DBEAFE;
}

QLineEdit {
    padding: 7px 10px;
    border: 1px solid #334155;
    border-radius: 8px;
    background-color: #0F172A;
    color: #E2E8F0;
    selection-background-color: #1D4ED8;
}

QLineEdit:hover {
    border-color: #475569;
}

QLineEdit:focus {
    border: 2px solid #3B82F6;
    padding: 6px 9px;
}

QLineEdit:disabled {
    background-color: #16213A;
    color: #64748B;
}

/* 表格内嵌输入框：减小上下 padding，避免被行高压扁导致文字不可见 */
QTableWidget QLineEdit {
    padding: 3px 8px;
}

QComboBox {
    padding: 7px 10px;
    border: 1px solid #334155;
    border-radius: 8px;
    background-color: #0F172A;
    color: #E2E8F0;
}

QComboBox:hover {
    border-color: #475569;
}

QComboBox:focus {
    border: 2px solid #3B82F6;
}

QComboBox::drop-down {
    border: none;
    width: 26px;
}

QComboBox::down-arrow {
    image: none;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid #94A3B8;
    margin-right: 8px;
}

QComboBox QAbstractItemView {
    background-color: #1E293B;
    border: 1px solid #334155;
    border-radius: 8px;
    padding: 4px;
    color: #E2E8F0;
    selection-background-color: #1E3A8A;
    selection-color: #F1F5F9;
    outline: none;
}

QSpinBox {
    padding: 6px 10px;
    border: 1px solid #334155;
    border-radius: 8px;
    background-color: #0F172A;
    color: #E2E8F0;
}

QProgressBar {
    border: none;
    border-radius: 6px;
    text-align: center;
    background-color: #1E293B;
    color: #CBD5E1;
    font-size: 12px;
    min-height: 12px;
}

QProgressBar::chunk {
    background-color: #3B82F6;
    border-radius: 6px;
}

QStatusBar {
    background-color: #0F172A;
    border-top: 1px solid #1E293B;
    padding: 4px 8px;
    color: #94A3B8;
}

QStatusBar::item {
    border: none;
}

QStatusBar QLabel {
    color: #94A3B8;
    padding: 0 10px;
    font-size: 12px;
}

QLabel {
    color: #E2E8F0;
}

QCheckBox {
    spacing: 8px;
    color: #E2E8F0;
}

QCheckBox::indicator {
    width: 17px;
    height: 17px;
    border: 1.5px solid #475569;
    border-radius: 5px;
    background-color: #0F172A;
}

QCheckBox::indicator:hover {
    border-color: #3B82F6;
    background-color: #1E293B;
}

QCheckBox::indicator:checked {
    background-color: #2563EB;
    border-color: #2563EB;
}

QRadioButton {
    spacing: 8px;
    color: #E2E8F0;
}

QRadioButton::indicator {
    width: 17px;
    height: 17px;
    border: 1.5px solid #475569;
    border-radius: 9px;
    background-color: #0F172A;
}

QRadioButton::indicator:checked {
    background-color: #2563EB;
    border-color: #2563EB;
}

QDialog {
    background-color: #0F172A;
    color: #E2E8F0;
}

QMessageBox {
    background-color: #0F172A;
    color: #E2E8F0;
}

QMessageBox QLabel {
    color: #E2E8F0;
    font-size: 13px;
}

QTabWidget::pane {
    border: 1px solid #334155;
    border-radius: 10px;
    background-color: #0F172A;
    top: -1px;
}

QTabBar::tab {
    background-color: transparent;
    border: none;
    border-bottom: 2px solid transparent;
    padding: 9px 18px;
    color: #94A3B8;
    font-weight: 500;
}

QTabBar::tab:selected {
    border-bottom: 2px solid #3B82F6;
    color: #93C5FD;
}

QTabBar::tab:hover:!selected {
    color: #F1F5F9;
}

QScrollBar:vertical {
    background-color: transparent;
    width: 10px;
    margin: 2px;
    border: none;
}

QScrollBar::handle:vertical {
    background-color: #475569;
    border-radius: 5px;
    min-height: 32px;
}

QScrollBar::handle:vertical:hover {
    background-color: #64748B;
}

QScrollBar:horizontal {
    background-color: transparent;
    height: 10px;
    margin: 2px;
    border: none;
}

QScrollBar::handle:horizontal {
    background-color: #475569;
    border-radius: 5px;
    min-width: 32px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #64748B;
}

QScrollBar::add-line, QScrollBar::sub-line {
    width: 0px;
    height: 0px;
}

QScrollBar::add-page, QScrollBar::sub-page {
    background: transparent;
}

QSplitter::handle {
    background-color: transparent;
}

QSplitter::handle:horizontal {
    width: 6px;
}

QSplitter::handle:vertical {
    height: 6px;
}

QSplitter::handle:hover {
    background-color: #334155;
}

/* 滚动区域：视口透明跟随容器背景（避免缝隙透出系统暗色） */
QScrollArea {
    background-color: transparent;
    border: none;
}

QScrollArea > QWidget > QWidget {
    background-color: transparent;
}

QToolTip {
    background-color: #1E293B;
    border: 1px solid #475569;
    border-radius: 6px;
    color: #F1F5F9;
    padding: 6px 10px;
    font-size: 12px;
}
